{
  "name": "alim-launcher",
  "version": "1.0.2",
  "description": "Alim Launcher — Minecraft Java Edition",
  "main": "out/main.js",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "assets": "node scripts/assets.mjs",
    "test:ui": "playwright test",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "keywords": [],
  "author": "Alim",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "@xmcl/task": "^4.1.1",
    "@xmcl/unzip": "2.1.2",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "skinview3d": "^3.4.2",
    "undici": "7.30.1",
    "yauzl": "3.4.0",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maga17mm-hub/alim-launcher.git"
  },
  "overrides": {
    "undici": "7.30.1",
    "sprintf-js": "1.1.3",
    "yauzl": "3.4.0"
  }
}
